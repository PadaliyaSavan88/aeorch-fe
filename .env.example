# Backend API base URL (Express API in ../aeorch)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Canonical site URL — used in metadata, JSON-LD, and llms.txt generation
NEXT_PUBLIC_SITE_URL=https://aeorch.com

# Google Analytics measurement ID (optional — GA is only mounted if this is set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

